    "source_code": "#include <iostream>\n#include <vector>\nusing namespace std;\n\nint duplicateNumber(vector<int>& nums) {\n  int left = 0;\n  int right = nums.size();\n\n  while (left + 1 < right) {\n    int mid = (right + left) / 2;\n\n    if (nums[mid] == nums[mid - 1]) {\n      return nums[mid];\n    } else if (nums[mid] > mid) {\n      left = mid;\n    } else {\n      right = mid;\n    }\n  }\n\n  return nums[left];\n}",
