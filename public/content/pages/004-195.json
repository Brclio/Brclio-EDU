08/image/5894143396020224"}}},"1567493539556":{"educativeObjContent":{"type":"MxGraph","mode":"edit","content":{"xml_string":"<mxGraphModel><root><mxCell id=\"0\"/><mxCell id=\"1\" parent=\"0\"/><mxCell id=\"5132\" value=\"&lt;span&gt;&lt;font style=&quot;font-size: 40px&quot; face=&quot;Courier New&quot; color=&quot;#990000&quot;&gt;&lt;b&gt;Never odd or even&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;\" style=\"text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;\" parent=\"1\" vertex=\"1\"><mxGeometry x=\"150\" y=\"180\" width=\"530\" height=\"20\" as=\"geometry\"/></mxCell></root></mxGraphModel>","svg_string":null,"path":"/api/collection/10370001/5474278013140992/page/6500398984593408/image/4731787806769152"}}},"1567493539557":{"educativeObjContent":{"type":"MxGraph","mode":"edit","content":{"xml_string":"<mxGraphModel><root><mxCell id=\"0\"/><mxCell id=\"1\" parent=\"0\"/><mxCell id=\"5132\" value=\"&lt;font face=&quot;Courier New&quot; style=&quot;font-size: 40px&quot; color=&quot;#ffb570&quot;&gt;&lt;b&gt;radar&lt;/b&gt;&lt;/font&gt;\" style=\"text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;\" parent=\"1\" vertex=\"1\"><mxGeometry x=\"150\" y=\"180\" width=\"530\" height=\"20\" as=\"geometry\"/></mxCell></root></mxGraphModel>","svg_string":null,"path":"/api/collection/10370001/5474278013140992/page/6500398984593408/image/6453796358062080"}}},"1567493539558":{"educativeObjContent":{"type":"MxGraph","mode":"edit","content":{"xml_string":"<mxGraphModel><root><mxCell id=\"0\"/><mxCell id=\"1\" parent=\"0\"/><mxCell id=\"5132\" value=\"&lt;span&gt;&lt;font style=&quot;font-size: 35px&quot; face=&quot;Courier New&quot; color=&quot;#990000&quot;&gt;&lt;b&gt;Live on time, emit no evil&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;\" style=\"text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;\" parent=\"1\" vertex=\"1\"><mxGeometry x=\"150\" y=\"180\" width=\"640\" height=\"20\" as=\"geometry\"/></mxCell></root></mxGraphModel>","svg_string":null,"path":"/api/collection/10370001/5474278013140992/page/6500398984593408/image/6681204407402496"}}}},"file":"/content/assets/5fe64c04889e92e4cfc3.svg"}],"selected_canvas":0,"keys":[0],"learn_status":"undo"},"mode":"view","step":1},{"type":"MarkdownEditor","content":{"version":"1.0","comp_id":"04e99f200bbd11eca6a73af9d3c2d1d5","text":"## 编码实现\n\n让我们动手编程实现吧！\n\n### 算法1","text_html":"<h2>编码实现</h2>\n<p>让我们动手编程实现吧！</p>\n<h3>算法1</h3>\n","learn_status":"undo"},"mode":"view","step":2},{"type":"Code","content":{"version":"1.0","comp_id":"04e99f520bbd11eca6a73af9d3c2d1d5","title":"","caption":"","language":"python3","special_input":"no-input","entry_file_name":"main.py","content":"s = \"Was it a cat I saw?\"\n\n# 使用了与字符串s相同的空间消耗\ns = ''.join([i for i in s if i.isalnum()]).replace(\" \", \"\").lower()\nprint(s == s[::-1])","time_limit":30,"allow_download":false,"read_only":false,"high_lighted_lines":"4","runnable":true,"judge":false,"judge_content_prepend":"\n\n\n","show_solution":false,"solution_content":"\n\n\n","additional_content":[],"hidden_code_content":{"prepend_code":"\n\n","append_code":"\n\n","code_selection":"prependCode"},"judge_content":null,"judge_hints":null,"learn_status":"undo"},"mode":"view","step":3},{"type":"MarkdownEditor","content":{"version":"1.0","comp_id":"04e99f7a0bbd11eca6a73af9d3c2d1d5","text":"让我们讨论下**第4行**的单行代码。列表推导语句`[i for i in s if i.isalnum()]`语句返回一个所有字母或数字的新列表。这有助于我们去掉问号、空格和所有非字母数字的字符。同一行的`join`函数将这个列表中的元素连接成一个字符串，通过`lower`函数将其变成小写字母。\n\n最后，在**第5行**，用修改后字符串`s`与它的反转形式(`s[::-1]`)进行比较。如果两者相等则是回文，`True`输出，否则 `False`输出。\n\n上述解决方案非常简洁，但由于它需要**额外的空间**。另外一种算法它可以在不增加额外空间的情况下解决问题。我们开始吧!\n\n### 算法2 - 无额外空间消耗","text_html":"<p>让我们讨论下<strong>第4行</strong>的单行代码。列表推导语句<code>[i for i in s if i.isalnum()]</code>语句返回一个所有字母或数字的新列表。这有助于我们去掉问号、空格和所有非字母数字的字符。同一行的<code>join</code>函数将这个列表中的元素连接成一个字符串，通过<code>lower</code>函数将其变成小写字母。</p>\n<p>最后，在<strong>第5行</strong>，用修改后字符串<code>s</code>与它的反转形式(<code>s[::-1]</code>)进行比较。如果两者相等则是回文，<code>True</code>输出，否则 <code>False</code>输出。</p>\n<p>上述解决方案非常简洁，但由于它需要<strong>额外的空间</strong>。另外一种算法它可以在不增加额外空间的情况下解决问题。我们开始吧!</p>\n<h3>算法2 - 无额外空间消耗</h3>\n","learn_status":"undo"},"mode":"view","step":4},{"type":"Code","content":{"version":"1.0","comp_id":"04e99fac0bbd11eca6a73af9d3c2d1d5","title":"","caption":"is_palindrome(s)","language":"python3","special_input":"no-input","entry_file_name":"main.py","content":"def is_palindrome(s):\n    i = 0\n    j = len(s) - 1\n\n    while i < j:\n        while not s[i].isalnum() and i < j: # 过滤非字母 或 数字\n            i += 1\n        while not s[j].isalnum() and i < j: # 过滤非字母 或 数字\n            j -= 1\n\n        if s[i].lower() != s[j].lower():    # 判断前后位置相等\n            return False \n        i += 1                              # i += 1，向前\n        j -= 1                              # j -= 1，向后\n    return True\n\ns = \"Was it a cat I saw?\"\nprint(is_palindrome(s))","time_limit":30,"allow_download":false,"read_only":false,"high_lighted_lines":"","runnable":true,"judge":false,"judge_content_prepend":"\n\n\n","show_solution":false,"solution_content":"\n\n\n","additional_content":[],"hidden_code_content":{"prepend_code":"\n\n","append_code":"\n\n","code_selection":"prependCode"},"judge_content":null,"judge_hints":null,"learn_status":"undo"},"mode":"view","step":5},{"type":"MarkdownEditor","content":{"version":"1.0","comp_id":"04e99fd40bbd11eca6a73af9d3c2d1d5","text":"`i`和`j`是两个迭代器，指向`s`的第一个和最后一个字符（**第2-3行**）。\n接下来，我们在**第5行**有一个`while`循环，只要`i`小于`j`就运行。`i`应该从`s`的开头向前走，而`j`必须从`s`的结尾向后走。因此，在**第6行**和**第8行**，我们有两个`while`循环，相应地递增或递减迭代器。因此，如果`s[i]`不是字母数字，并且`i`小于`j`，则`i`在**第7行**被递增。同样，如果`s[j]`不是字母数字，并且`i`小于`j`，则`j`在**第9行**被递减。这将帮助我们忽略`s`中所有非字母数字的字符。\n\n在**第11行**，我们通过比较`s[i]`和`s[j]`来检查回文属性。它们必须相同，才能使`s`成为一个回文：\n- 如果`s[i]`和`s[j]`不匹配，则在**第12行**的函数中返回`False`，表示`i`所指向的字符与`j`所指向的字符不一致的情况\n\n- 如果`s[i]`等于`s[j]`，执行到**第13-14行**，`i`被递增，`j`被递减，进入下一个字符。\n\n- 如果**第11行**的条件在`while`循环的所有迭代中保持 `False`，则在**第15行**返回 `True`，表明`s`确实是一个回文。\n\n\n这就总结出了一切!在这一课中，你学到了如何检查一个字符串是否为回文。\n\n----\n\n在下一课中，我们将探讨如何发现一个字符串是否是变形词。","text_html":"<p><code>i</code>和<code>j</code>是两个迭代器，指向<code>s</code>的第一个和最后一个字符（<strong>第2-3行</strong>）。\n接下来，我们在<strong>第5行</strong>有一个<code>while</code>循环，只要<code>i</code>小于<code>j</code>就运行。<code>i</code>应该从<code>s</code>的开头向前走，而<code>j</code>必须从<code>s</code>的结尾向后走。因此，在<strong>第6行</strong>和<strong>第8行</strong>，我们有两个<code>while</code>循环，相应地递增或递减迭代器。因此，如果<code>s[i]</code>不是字母数字，并且<code>i</code>小于<code>j</code>，则<code>i</code>在<strong>第7行</strong>被递增。同样，如果<code>s[j]</code>不是字母数字，并且<code>i</code>小于<code>j</code>，则<code>j</code>在<strong>第9行</strong>被递减。这将帮助我们忽略<code>s</code>中所有非字母数字的字符。</p>\n<p>在<strong>第11行</strong>，我们通过比较<code>s[i]</code>和<code>s[j]</code>来检查回文属性。它们必须相同，才能使<code>s</code>成为一个回文：</p>\n<ul>\n<li>\n<p>如果<code>s[i]</code>和<code>s[j]</code>不匹配，则在<strong>第12行</strong>的函数中返回<code>False</code>，表示<code>i</code>所指向的字符与<code>j</code>所指向的字符不一致的情况</p>\n</li>\n<li>\n<p>如果<code>s[i]</code>等于<code>s[j]</code>，执行到<strong>第13-14行</strong>，<code>i</code>被递增，<code>j</code>被递减，进入下一个字符。</p>\n</li>\n<li>\n<p>如果<strong>第11行</strong>的条件在<code>while</code>循环的所有迭代中保持 <code>False</code>，则在<strong>第15行</strong>返回 <code>True</code>，表明<code>s</code>确实是一个回文。</p>\n</li>\n</ul>\n<p>这就总结出了一切!在这一课中，你学到了如何检查一个字符串是否为回文。</p>\n<hr />\n<p>在下一课中，我们将探讨如何发现一个字符串是否是变形词。</p>\n","learn_status":"undo"},"mode":"edit","step":6}],"status":"undo","course_no":"004","source_url":"https://edu.py2fun.com/api/course/004/page/195"}
