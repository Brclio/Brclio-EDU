ent = None\n</code></pre>\n","explanation":{"md_text":"","md_html":""},"correct":false},{"text":"```python\nclass Node:\n    def __init__(self, val): \n        self.val = val\n        self.leftChild = None \n        self.rightChild = None\n ```\n","text_html":"<pre><code class=\"language-python\">class Node:\n    def __init__(self, val): \n        self.val = val\n        self.leftChild = None \n        self.rightChild = None\n</code></pre>\n","explanation":{"md_text":"","md_html":""},"correct":true},{"text":"```python\nclass Node:\n    def __init__(self, val):\n        self.val = val\n        self.Child = None \n ```\n","text_html":"<pre><code class=\"language-python\">class Node:\n    def __init__(self, val):\n        self.val = val\n        self.Child = None \n</code></pre>\n","explanation":{"md_text":"","md_html":""},"correct":false}]}],"learn_status":"undo"},"mode":"edit","step":0}],"status":"undo","course_no":"004","source_url":"https://edu.py2fun.com/api/course/004/page/175"}
