 y=\"170\" as=\"targetPoint\"/></mxGeometry></mxCell></root></mxGraphModel>","svg_string":"","path":"/api/collection/5408907848056832/6512370674827264/page/6015515000045568/image/6625495487086592"}}}},"file":"/content/assets/2c3429ed8553240adb18.svg"}],"selected_canvas":0,"keys":[0],"learn_status":"undo"},"mode":"view","step":4},{"type":"MarkdownEditor","content":{"version":"1.0","comp_id":"9564afba-98c9-4c7a-ab07-9311e73335e9","text":"在这种情况下，峰值元素是在列表的最后。\n\n### 时间复杂度\n\n该代码给给出一个最坏情况下的时间复杂度$O(n)$。\n\n**有什么更好的解决思路吗？**\n\n## 解法2\n\n利用**分而治之**，可以加速整个过程。请看下面给出的代码：","text_html":"<p>在这种情况下，峰值元素是在列表的最后。</p>\n<h3>时间复杂度</h3>\n<p>该代码给给出一个最坏情况下的时间复杂度<span class=\"katex\"><span class=\"katex-mathml\"><math><semantics><mrow><mi>O</mi><mo>(</mo><mi>n</mi><mo>)</mo></mrow><annotation encoding=\"application/x-tex\">O(n)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"strut\" style=\"height:0.75em;\"></span><span class=\"strut bottom\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"base textstyle uncramped\"><span class=\"mord mathit\" style=\"margin-right:0.02778em;\">O</span><span class=\"mopen\">(</span><span class=\"mord mathit\">n</span><span class=\"mclose\">)</span></span></span></span>。</p>\n<p><strong>有什么更好的解决思路吗？</strong></p>\n<h2>解法2</h2>\n<p>利用<strong>分而治之</strong>，可以加速整个过程。请看下面给出的代码：</p>\n","learn_status":"undo"},"mode":"edit","step":5},{"type":"TabbedCode","content":{"version":"1.0","comp_id":"b51b5b21-ee63-48bb-9f95-9b9c46771c3c","caption":"","code_contents":[{"version":"1.0","comp_id":"tab_code_0_b51b5b21-ee63-48bb-9f95-9b9c46771c3c","title":"Find_Peak_Element","caption":"","language":"python3","special_input":"","entry_file_name":"main.py","content":"# Utility function\ndef find_peak_recursive(low, high, lst):\n    \"\"\"\n    Finds a peak element\n    :param low: Starting index of a given list\n    :param high: Ending index of a given list\n    :param lst: List of integers\n    :return: Returns a peak element in a given list\n    \"\"\"\n    # Finding the middle index\n    middle = low + (high - low) // 2\n\n    # If there are neighbours\n    if (middle == len(lst) - 1 or lst[middle + 1] <= lst[middle]) and (middle == 0 or lst[middle - 1] <= lst[middle]):\n        return middle\n\n    # If left neighbour is greater, then peak element is in the left half\n    elif (lst[middle - 1] > lst[middle]) and middle > 0:\n        return find_peak_recursive(low, (middle - 1), lst)\n\n    # If right neighbour is greater, then peak element is in the right half\n    else:\n        return find_peak_recursive((middle + 1), high, lst)\n\n\ndef find_peak(lst):\n    \"\"\"\n    Finds a peak element\n    :param lst: List of integers\n    :return: Returns a peak element in a given list\n    \"\"\"\n    return lst[find_peak_recursive(0, len(lst) - 1, lst)]\n\n# Driver code to test above function\nif __name__ == '__main__':\n\n    # Example: 1\n    lst = [7, 11, 22, 13, 4, 0]\n    print('One peak point is: ', find_peak(lst))\n\n    # Example: 2\n    lst = [0, 3, 100, 2, -1, 0]\n    print('One peak point is: ', find_peak(lst))\n\n    # Example: 3\n    lst = [6, 5, 4, 3, 2, 1]\n    print('One peak point is: ', find_peak(lst))","time_limit":30,"allow_download":false,"read_only":false,"high_lighted_lines":"11\n14\n18\n23","runnable":true,"judge":false,"judge_content_prepend":"","show_solution":false,"solution_content":"\n\n\n","additional_content":[],"hidden_code_content":{"prepend_code":"\n\n","append_code":"\n\n","code_selection":"prependCode"},"judge_content":null,"judge_hints":null}],"learn_status":"undo"},"mode":"view","step":6},{"type":"MarkdownEditor","content":{"version":"1.0","comp_id":"b246ebb9-0e6d-4b9e-994b-753a0d1a4e54","text":"### 解释\n\n从列表的中间元素开始(**第11行**): \n\n- 将该元素与其相邻的元素进行比较\n\n  - 如果中间元素不比任何一个相邻的元素小，就返回它(**14行**)。\n\n  - 如果中间的元素比左邻居小，那么在左半边总是有一个峰值(**第18行**)。\n\n  - 如果中间的元素比右邻居小，那么在右半边总是有一个峰值(**第23行**）。\n\n上述算法总是能保证成功。让$i$为中间元素，$i-1$和$i+1$分别为左边和右边的元素。如果我们选择左边的（$i-1$）元素，因为它比较大，我们可以肯定至少有一个（$i-1$）的邻居比较小，即$i$。\n\n($i-1$)的另一个邻居，如果较小，则($i-1$)为峰值元素。我们可以对元素（$i-2$）采用同样的逻辑，以此类推，直到我们到达角元素(即首尾元素)，在这种情况下，角元素必须是峰值元素。\n\n> 上述代码，建议仔细阅读并思考。此问题经常作为算法高频面试问题。其中列表非排序，但是使用了类似二分的思想来解决！\n\n### 时间复杂度\n\n使用这种技术，在每次递归调用中都要放弃一半的列表。因此，每次调用之后，与上次调用相比，我们只剩下一半的工作。使用这种分而治之的技术，时间复杂度$O(lg$ $n)$。\n\n---\n\n是时候进入下一个挑战了!","text_html":"<h3>解释</h3>\n<p>从列表的中间元素开始(<strong>第11行</strong>):</p>\n<ul>\n<li>\n<p>将该元素与其相邻的元素进行比较</p>\n<ul>\n<li>\n<p>如果中间元素不比任何一个相邻的元素小，就返回它(<strong>14行</strong>)。</p>\n</li>\n<li>\n<p>如果中间的元素比左邻居小，那么在左半边总是有一个峰值(<strong>第18行</strong>)。</p>\n</li>\n<li>\n<p>如果中间的元素比右邻居小，那么在右半边总是有一个峰值(<strong>第23行</strong>）。</p>\n</li>\n</ul>\n</li>\n</ul>\n<p>上述算法总是能保证成功。让<span class=\"katex\"><span class=\"katex-mathml\"><math><semantics><mrow><mi>i</mi></mrow><annotation encoding=\"application/x-tex\">i</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"strut\" style=\"height:0.65952em;\"></span><span class=\"strut bottom\" style=\"height:0.65952em;vertical-align:0em;\"></span><span class=\"base textstyle uncramped\"><span class=\"mord mathit\">i</span></span></span></span>为中间元素，<span class=\"katex\"><span class=\"katex-mathml\"><math><semantics><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding=\"application/x-tex\">i-1</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"strut\" style=\"height:0.65952em;\"></span><span class=\"strut bottom\" style=\"height:0.74285em;vertical-align:-0.08333em;\"></span><span class=\"base textstyle uncramped\"><span class=\"mord mathit\">i</span><span class=\"mbin\">−</span><span class=\"mord mathrm\">1</span></span></span></span>和<span class=\"katex\"><span class=\"katex-mathml\"><math><semantics><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding=\"application/x-tex\">i+1</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"strut\" style=\"height:0.65952em;\"></span><span class=\"strut bottom\" style=\"height:0.74285em;vertical-align:-0.08333em;\"></span><span class=\"base textstyle uncramped\"><span class=\"mord mathit\">i</span><span class=\"mbin\">+</span><span class=\"mord mathrm\">1</span></span></span></span>分别为左边和右边的元素。如果我们选择左边的（<span class=\"katex\"><span class=\"katex-mathml\"><math><semantics><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding=\"application/x-tex\">i-1</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"strut\" style=\"height:0.65952em;\"></span><span class=\"strut bottom\" style=\"height:0.74285em;vertical-align:-0.08333em;\"></span><span class=\"base textstyle uncramped\"><span class=\"mord mathit\">i</span><span class=\"mbin\">−</span><span class=\"mord mathrm\">1</span></span></span></span>）元素，因为它比较大，我们可以肯定至少有一个（<span class=\"katex\"><span class=\"katex-mathml\"><math><semantics><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding=\"application/x-tex\">i-1</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"strut\" style=\"height:0.65952em;\"></span><span class=\"strut bottom\" style=\"height:0.74285em;vertical-align:-0.08333em;\"></span><span class=\"base textstyle uncramped\"><span class=\"mord mathit\">i</span><span class=\"mbin\">−</span><span class=\"mord mathrm\">1</span></span></span></span>）的邻居比较小，即<span class=\"katex\"><span class=\"katex-mathml\"><math><semantics><mrow><mi>i</mi></mrow><annotation encoding=\"application/x-tex\">i</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"strut\" style=\"height:0.65952em;\"></span><span class=\"strut bottom\" style=\"height:0.65952em;vertical-align:0em;\"></span><span class=\"base textstyle uncramped\"><span class=\"mord mathit\">i</span></span></span></span>。</p>\n<p>(<span class=\"katex\"><span class=\"katex-mathml\"><math><semantics><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding=\"application/x-tex\">i-1</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"strut\" style=\"height:0.65952em;\"></span><span class=\"strut bottom\" style=\"height:0.74285em;vertical-align:-0.08333em;\"></span><span class=\"base textstyle uncramped\"><span class=\"mord mathit\">i</span><span class=\"mbin\">−</span><span class=\"mord mathrm\">1</span></span></span></span>)的另一个邻居，如果较小，则(<span class=\"katex\"><span class=\"katex-mathml\"><math><semantics><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding=\"application/x-tex\">i-1</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"strut\" style=\"height:0.65952em;\"></span><span class=\"strut bottom\" style=\"height:0.74285em;vertical-align:-0.08333em;\"></span><span class=\"base textstyle uncramped\"><span class=\"mord mathit\">i</span><span class=\"mbin\">−</span><span class=\"mord mathrm\">1</span></span></span></span>)为峰值元素。我们可以对元素（<span class=\"katex\"><span class=\"katex-mathml\"><math><semantics><mrow><mi>i</mi><mo>−</mo><mn>2</mn></mrow><annotation encoding=\"application/x-tex\">i-2</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"strut\" style=\"height:0.65952em;\"></span><span class=\"strut bottom\" style=\"height:0.74285em;vertical-align:-0.08333em;\"></span><span class=\"base textstyle uncramped\"><span class=\"mord mathit\">i</span><span class=\"mbin\">−</span><span class=\"mord mathrm\">2</span></span></span></span>）采用同样的逻辑，以此类推，直到我们到达角元素(即首尾元素)，在这种情况下，角元素必须是峰值元素。</p>\n<blockquote>\n<p>上述代码，建议仔细阅读并思考。此问题经常作为算法高频面试问题。其中列表非排序，但是使用了类似二分的思想来解决！</p>\n</blockquote>\n<h3>时间复杂度</h3>\n<p>使用这种技术，在每次递归调用中都要放弃一半的列表。因此，每次调用之后，与上次调用相比，我们只剩下一半的工作。使用这种分而治之的技术，时间复杂度<span class=\"katex\"><span class=\"katex-mathml\"><math><semantics><mrow><mi>O</mi><mo>(</mo><mi>l</mi><mi>g</mi></mrow><annotation encoding=\"application/x-tex\">O(lg</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"strut\" style=\"height:0.75em;\"></span><span class=\"strut bottom\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"base textstyle uncramped\"><span class=\"mord mathit\" style=\"margin-right:0.02778em;\">O</span><span class=\"mopen\">(</span><span class=\"mord mathit\" style=\"margin-right:0.01968em;\">l</span><span class=\"mord mathit\" style=\"margin-right:0.03588em;\">g</span></span></span></span> <span class=\"katex\"><span class=\"katex-mathml\"><math><semantics><mrow><mi>n</mi><mo>)</mo></mrow><annotation encoding=\"application/x-tex\">n)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"strut\" style=\"height:0.75em;\"></span><span class=\"strut bottom\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"base textstyle uncramped\"><span class=\"mord mathit\">n</span><span class=\"mclose\">)</span></span></span></span>。</p>\n<hr />\n<p>是时候进入下一个挑战了!</p>\n","learn_status":"undo"},"mode":"view","step":7}],"status":"undo","course_no":"010","source_url":"https://edu.py2fun.com/api/course/010/page/518"}
