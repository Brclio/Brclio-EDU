, 2, '12']]\na_list.remove('12')\nprint(a_list)\n","time_limit":30,"allow_download":false,"read_only":false,"high_lighted_lines":"","runnable":true,"judge":false,"judge_content_prepend":"\n\n\n","show_solution":false,"solution_content":"\n\n\n","additional_content":[],"hidden_code_content":{"prepend_code":"\n\n","append_code":"\n\n","code_selection":"prependCode"},"judge_content":null,"judge_hints":null},"mode":"edit","step":5},{"type":"MarkdownEditor","content":{"version":"1.0","comp_id":"c9b976ca-359c-3c9b-84dc-8617b1e81dec","title":"","title_html":"","text":"输出为:`[1, 2, [1, 2, '12']]`。\n> 注意：`remove()`方法传入的是列表元素的值，不是下标，并且只会删除出现的第一个，如果传入的值不在列表中，会报错。","text_html":"<p>输出为:<code>[1, 2, [1, 2, &#x27;12&#x27;]]</code>。</p>\n<blockquote>\n<p>注意：<code>remove()</code>方法传入的是列表元素的值，不是下标，并且只会删除出现的第一个，如果传入的值不在列表中，会报错。</p>\n</blockquote>\n"},"mode":"edit","step":6}],"question_type":"single_choice","question_text":"下面哪一项不属于Python列表的内置方法","question_text_html":"<p>下面哪一项不属于Python列表的内置方法</p>\n","question_options":[{"id":10291,"key":"A","text":"add","text_html":"<p>add</p>\n","explanation":{"md_text":"","md_html":""},"correct":true,"match_number":0,"max_length":0,"properties":{}},{"id":10292,"key":"B","text":"append","text_html":"<p>append</p>\n","explanation":{"md_text":"","md_html":""},"correct":false,"match_number":0,"max_length":0,"properties":{}},{"id":10293,"key":"C","text":"remove","text_html":"<p>remove</p>\n","explanation":{"md_text":"","md_html":""},"correct":false,"match_number":0,"max_length":0,"properties":{}},{"id":10294,"key":"D","text":"pop","text_html":"<p>pop</p>\n","explanation":{"md_text":"","md_html":""},"correct":false,"match_number":0,"max_length":0,"properties":{}}],"user_answers":null,"is_right":null}},{"type":"QuizRef","content":{"version":"1.0","comp_id":"0f7147a4-0f4c-366e-9cc8-bcf70408c2d2","title":" 元组tuple","question_id":2919,"learn_status":"undo"},"mode":"edit","step":1,"resolved":{"question_id":2919,"title":" 元组tuple","description":"","description_en