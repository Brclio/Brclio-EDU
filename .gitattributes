* text=auto
*.svg text
*.json text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp4 binary
*.wasm binary
*.whl binary
*.bin binary
*.zip binary
# Preserve captured response/data bytes, including CRLF, GBK and trailing spaces.
public/content/fixtures/** binary
public/content/runtime-data/*.csv binary
public/content/runtime-data/*.txt binary
runner/fixtures/content/** binary
public/content/runtime-data/*.rst binary

# Keep the verified upstream editor distribution byte-for-byte unchanged.
public/runtime/monaco/** -text -whitespace linguist-vendored
