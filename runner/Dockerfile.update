# Offline overlay of the already-built trusted toolchains; no APT or downloads.
ARG BASE_IMAGE=brclio-edu-toolchains:20261102
FROM ${BASE_IMAGE}
USER root
COPY execute.py protocol.py process_utils.py /opt/runner/
COPY offline/ /opt/runner/offline/
COPY fixtures/ /opt/fixtures/
RUN chmod -R a=rX /opt/runner /opt/fixtures
USER 65534:65534
WORKDIR /work
